# ===========================================
# SEO Agent - Frontend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ===========================================

# -----------------------------------------------------------------------------
# API BACKEND URL
# -----------------------------------------------------------------------------
# Development (local backend):
VITE_API_URL=http://localhost:8000/api

# Production - AFTER DEPLOYING BACKEND, update with Render URL:
# VITE_API_URL=https://seo-agent-api-xxxx.onrender.com/api
# -----------------------------------------------------------------------------
# IMPORTANT: Set this BEFORE deploying to Vercel
# Check DEPLOYMENT_LINKING.md for step-by-step instructions
# -----------------------------------------------------------------------------

# ===========================================
# EXAMPLE PRODUCTION .env:
# ===========================================
# VITE_API_URL=https://seo-agent-api.onrender.com/api
# ===========================================