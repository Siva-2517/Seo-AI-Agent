# ===========================================
# SEO Agent - Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ===========================================

# -----------------------------------------------------------------------------
# REQUIRED - Google Gemini API
# Get your API key from: https://makersuite.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# DATABASE - Neon PostgreSQL (Production) or SQLite (Development)
# Neon PostgreSQL format: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# SQLite format: sqlite:///./seo_agent.db
# -----------------------------------------------------------------------------
# Development (SQLite):
DATABASE_URL=sqlite:///./seo_agent.db

# Production (Neon PostgreSQL) - REPLACE WITH YOUR NEON CONNECTION STRING:
# DATABASE_URL=postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
APP_NAME=SEO Agent
APP_VERSION=1.0.0

# DEBUG=false for production, true for development
DEBUG=false

# -----------------------------------------------------------------------------
# CORS - Comma-separated list of allowed origins
# Development:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Production - AFTER DEPLOYING FRONTEND, update with Vercel URL:
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.your-app.vercel.app
# -----------------------------------------------------------------------------
# IMPORTANT: Set this AFTER Vercel deploys and you get your frontend URL
# Check DEPLOYMENT_LINKING.md for step-by-step instructions
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# BUSINESS CONTEXT (Used for content generation)
# -----------------------------------------------------------------------------
REFERENCE_WEBSITE=https://appincoimbatore.com
BUSINESS_CATEGORY=Digital Marketing Course in Coimbatore
BUSINESS_NAME=Appin Technology
BUSINESS_LOCATION=Coimbatore

# -----------------------------------------------------------------------------
# SEO AGENT CONFIGURATION
# -----------------------------------------------------------------------------
MAX_RETRY_ATTEMPTS=2
MIN_VALIDATION_SCORE=70

# -----------------------------------------------------------------------------
# OPTIONAL - Monitoring & Logging
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://xxx@sentry.io/xxx
LOG_LEVEL=INFO

# ===========================================
# EXAMPLE PRODUCTION .env:
# ===========================================
# GEMINI_API_KEY=AIzaSyYourActualKeyHere
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# DEBUG=false
# ALLOWED_ORIGINS=https://seo-agent.vercel.app
# SENTRY_DSN=https://xxx@sentry.io/xxx
# LOG_LEVEL=WARNING
# ===========================================